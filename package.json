{
    "name": "wsg",
    "version": "1.0.0",
    "description": "A WhatsApp Web client mod with a plugin system",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "extension dev",
        "start": "extension start",
        "build": "bun run typecheck && extension build",
        "build:zip": "bun run typecheck && extension build --zip",
        "typecheck": "tsc --noEmit --pretty",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@types/chrome": "^0.3.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "extension": "^4.1.35",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2"
    }
}
