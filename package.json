{
    "name": "wsg",
    "version": "1.0.0",
    "description": "A WhatsApp Web browser extension written in TypeScript",
    "private": true,
    "type": "module",
    "scripts": {
        "format": "prettier --write .",
        "typecheck": "tsc --noEmit --pretty",
        "dev": "vite build --mode development --watch",
        "build": "bun run typecheck && vite build"
    },
    "devDependencies": {
        "@samrum/vite-plugin-web-extension": "^5.1.1",
        "@types/chrome": "^0.2.2",
        "@types/node": "^25.9.4",
        "@types/react": "^19.2.17",
        "prettier": "^3.9.4",
        "typescript": "^5.9.3",
        "vite": "^5.4.21"
    }
}
