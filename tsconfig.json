{
    "compilerOptions": {
        "target": "ES2022",
        "useDefineForClassFields": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": true,
        "strict": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "types": ["vite/client", "node", "chrome"],
        "paths": {
            "@common": ["./src/common"],
            "@common/*": ["./src/common/*"],
            "@lib": ["./src/lib"],
            "@lib/*": ["./src/lib/*"],
            "@resources": ["./resources"],
            "@resources/*": ["./resources/*"]
        },
        "jsx": "react-jsx",
        "jsxImportSource": "react"
    },
    "include": ["vite.config.ts", "src/**/*.ts", "src/**/*.tsx", "src/globals.d.ts"]
}
